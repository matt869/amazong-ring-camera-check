# ---------------------------------------------------------------------------
# Ring Check-in configuration. Copy to .env.local and fill in what you have.
# With nothing set, the app runs in demo mode: mock Ring devices, a seeded
# 9-week activity history, alerts logged to the console, template summaries.
# ---------------------------------------------------------------------------

# Base URL the app is served from (OAuth redirect URI, links in alerts).
# Use https:// in production; session cookies are then marked Secure.
APP_URL=http://localhost:3000

# --- Access ----------------------------------------------------------------
# The dashboard shows when someone is home alone, so it needs a password.
# Required once real Ring data is connected (the app stays locked without it).
APP_PASSWORD=
# Optional: separate key for signing session cookies. Defaults to one derived
# from APP_PASSWORD, so changing the password signs everyone out.
SESSION_SECRET=
# Optional: lets an external scheduler call GET /api/summary with
# "Authorization: Bearer <CRON_SECRET>" as a backstop to the built-in one.
CRON_SECRET=

# Where the SQLite database lives.
DATA_DIR=./data

# Timezone of the home being monitored (IANA name, e.g. Asia/Manila).
# Defaults to this computer's timezone; can also be changed in Settings.
HOME_TIMEZONE=

# --- Ring ------------------------------------------------------------------
# Easiest: run `npm run ring:login` once. It signs in to your Ring account
# (email, password, 2FA code typed by you) and writes RING_REFRESH_TOKEN here.
RING_REFRESH_TOKEN=

# Alternative for Ring partner API access (OAuth). Leave empty otherwise.
# With neither set (or RING_MOCK=true), the app runs on simulated demo data.
RING_MOCK=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_AUTH_URL=https://oauth.ring.com/oauth/authorize
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_API_BASE=https://api.ring.com
RING_OAUTH_SCOPE=client
# Shared secret used to verify X-Ring-Signature on incoming webhooks.
RING_WEBHOOK_SECRET=dev-webhook-secret

# --- AWS -------------------------------------------------------------------
# Standard AWS credential chain (env vars, ~/.aws, instance role) is used.
AWS_REGION=us-east-1
# SNS topic that family members are subscribed to (SMS / email). Empty = log only.
# Also turns on the escalation ladder's direct texts to the resident and neighbor
# (their numbers are set on the Settings page).
SNS_TOPIC_ARN=
# Set to enable Claude-written daily summaries via Amazon Bedrock.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- Alexa (optional) -------------------------------------------------------
# Skill ID of your Alexa custom skill (amzn1.ask.skill....). Unset = the
# /api/alexa endpoint is off. See docs/alexa.md.
ALEXA_SKILL_ID=

# --- Scheduler -------------------------------------------------------------
# How often the server re-evaluates the alert rules.
CHECK_INTERVAL_MINUTES=5
